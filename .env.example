# Supabase Configuration
# Get these from your Supabase project: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only Supabase key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application
NEXT_PUBLIC_APP_URL=https://localwork-sepia.vercel.app
NEXT_PUBLIC_APP_NAME=LocalWork

# Optional: Analytics, Email, etc.
# RESEND_API_KEY=your-resend-api-key
